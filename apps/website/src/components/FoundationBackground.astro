<foundation-background aria-hidden="true"><canvas></canvas></foundation-background>

<script>
  import { sweepingFoundation } from '../scripts/foundation/sweeping-foundation.js';

  class FoundationBackground extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const canvas = this.querySelector('canvas');
      const context = canvas?.getContext('2d');
      if (!canvas || !context) return;

      const sprite = (color: string) => {
        const image = document.createElement('canvas');
        image.width = image.height = 64;
        const ctx = image.getContext('2d')!;
        const gradient = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
        gradient.addColorStop(0, '#fffaf0');
        gradient.addColorStop(.08, color);
        gradient.addColorStop(.24, `${color}70`);
        gradient.addColorStop(1, `${color}00`);
        ctx.fillStyle = gradient; ctx.fillRect(0, 0, 64, 64);
        return image;
      };
      const blue = sprite('#86b7ff'), gold = sprite('#ffd099');
      const mesh = sweepingFoundation((ctx: CanvasRenderingContext2D, x: number, y: number, size = 9, alpha = 1, warm = false) => {
        ctx.globalAlpha = alpha;
        ctx.drawImage(warm ? gold : blue, x - size, y - size, size * 2, size * 2);
        ctx.globalAlpha = 1;
      });
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      let width = 0, height = 0, time = 0, previous = 0, frame = 0, visible = false;
      const draw = () => {
        if (!width || !height) return;
        context.setTransform(1, 0, 0, 1, 0, 0);
        context.clearRect(0, 0, canvas.width, canvas.height);
        const scale = height / 650;
        context.setTransform(scale * canvas.width / width, 0, 0, scale * canvas.height / height, 0, 0);
        mesh.animate(context, motion.matches ? mesh.stillTime : time);
      };
      const animate = (now: number) => {
        if (previous) time += (now - previous) / 1000;
        previous = now; draw(); frame = requestAnimationFrame(animate);
      };
      const update = () => {
        cancelAnimationFrame(frame); previous = 0;
        if (visible && !document.hidden && !motion.matches) frame = requestAnimationFrame(animate);
        else draw();
      };
      const resize = new ResizeObserver(() => {
        const bounds = this.getBoundingClientRect(); width = bounds.width; height = bounds.height;
        if (!width || !height) return;
        canvas.width = Math.round(width * devicePixelRatio);
        canvas.height = Math.round(height * devicePixelRatio);
        mesh.resize(width / (height / 650));
        draw();
      });
      resize.observe(this);
      const intersection = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; update(); });
      intersection.observe(this);
      motion.addEventListener('change', update);
      document.addEventListener('visibilitychange', update);
      this.cleanup = () => {
        cancelAnimationFrame(frame); resize.disconnect(); intersection.disconnect();
        motion.removeEventListener('change', update);
        document.removeEventListener('visibilitychange', update);
      };
    }

    disconnectedCallback() { this.cleanup?.(); }
  }
  customElements.define('foundation-background', FoundationBackground);
</script>

<style>
  foundation-background { position: absolute; inset: 0; z-index: -1; pointer-events: none;
    mask-image: linear-gradient(to bottom, transparent, #000 7%, #000); }
  canvas { display: block; width: 100%; height: 100%; }
</style>
