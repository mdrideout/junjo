---
interface Props { parallel?: boolean; }
const { parallel = false } = Astro.props;
const stages = ['Harvest', 'Run', 'Evaluate', 'Improve'];
const tasks = ['feature_a', 'feature_b', 'failure_mode_1', 'failure_mode_2'];
---
<improvement-cycle-motion class:list={{ parallel }}>
  <div class="visual-scroll" role="region" aria-label={parallel ? 'Four parallel recursive self improvement cycles' : 'Scheduled recursive self improvement cycle'}>
    {parallel ? <><svg class="parallel-wide" viewBox="0 0 1040 555" role="img" aria-label="feature_a, feature_b, failure_mode_1, and failure_mode_2 each run their own harvest, run, evaluate, and improve loop with shared datasets and telemetry in Junjo AI Studio.">
      <g class="stage-label">{stages.map((stage, i) => <text x={250 + i * 130} y="26">{stage}</text>)}</g>
      {tasks.map((task, row) => <g transform={`translate(0 ${85 + row * 120})`} class="parallel-row" data-row={row}>
        <text class="task-label" x="22" y="5">{task}</text>
        <path class="route dim-route" d="M175 0H224M666 0C744 0 756 0 823 0"/>
        <path class="route parallel-route" d="M250 0H640Q680 0 680 32T640 64H290Q250 64 250 26V0"/>
        <path class="arrow" d="m447 59-7 5 7 5"/>
        {stages.map((_, i) => <g class="parallel-stage" data-distance={i * 130} transform={`translate(${250 + i * 130} 0)`}>
          <circle class="stage-flash" r="25"/>
          <circle class="node" r="24"/>
          <circle class="node-core" r="4"/>
        </g>)}
        <circle class="loop-traveler" cx="250" cy="0" r="5"/>
        <path class="evidence-route" d="M666 0H825"/>
        <circle class="evidence-traveler" cx="666" cy="0" r="3"/>
      </g>)}
      <rect class="studio-panel" x="825" y="48" width="190" height="462" rx="24"/>
      <g class="studio-dots">{Array.from({ length: 12 }, (_, row) => Array.from({ length: 15 - row % 4 * 2 }, (_, col) => <circle cx={852 + row % 4 * 5 + col * 8} cy={111 + row * 9} r="1.3"/>))}</g>
      <g class="studio-label"><text x="920" y="271">Junjo</text><text x="920" y="297">AI Studio</text></g>
      <g class="note"><text x="920" y="338">Shared datasets</text><text x="920" y="362">Evaluation results</text><text x="920" y="386">Execution telemetry</text></g>
      <text class="note" x="442" y="544">Independent cycles · Shared evidence</text>
    </svg>
    <svg class="parallel-narrow" viewBox="0 0 480 645" role="img" aria-label="Four independent improvement cycles for feature_a, feature_b, failure_mode_1, and failure_mode_2 share evidence in Junjo AI Studio.">
      {tasks.map((task, row) => <g class="parallel-row" data-row={row} transform={`translate(0 ${28 + row * 120})`}>
        <text class="task-label" x="24" y="0">{task}</text>
        <path class="route parallel-route" d="M50 55H410Q438 55 438 72.5T410 90H78Q50 90 50 72.5V55"/>
        <path class="route dim-route" d={`M434 55H460V${492 - row * 120}`}/>
        {stages.map((stage, i) => <g class="parallel-stage" data-distance={i * 120} transform={`translate(${50 + i * 120} 55)`}>
          <text class="stage-label" y="-25">{stage}</text>
          <circle class="stage-flash" r="18"/><circle class="node" r="17"/><circle class="node-core" r="3"/>
        </g>)}
        <path class="arrow" d="m245 85-7 5 7 5"/>
        <circle class="loop-traveler" cx="50" cy="55" r="4"/>
        <path class="evidence-route" d={`M434 55H460V${492 - row * 120}`}/>
        <circle class="evidence-traveler" cx="434" cy="55" r="3"/>
      </g>)}
      <rect class="studio-panel" x="20" y="520" width="440" height="118" rx="16"/>
      <g class="studio-dots">{Array.from({ length: 10 }, (_, row) => Array.from({ length: 17 - row % 4 * 3 }, (_, col) => <circle cx={40 + row % 4 * 6 + col * 7} cy={542 + row * 8} r="1.5"/>))}</g>
      <text class="studio-label" x="318" y="560">Junjo AI Studio</text>
      <g class="note"><text x="318" y="585">Shared datasets</text><text x="318" y="607">Results · Telemetry</text></g>
    </svg></> : <svg viewBox="0 0 1040 280" role="img" aria-label="A dotted clock triggers a job that travels through harvest, run, evaluate, and improve before returning evidence for the next scheduled cycle.">
      <g class="clock-face">{Array.from({ length: 60 }, (_, i) => { const angle = i / 60 * Math.PI * 2; return <circle class:list={{ hour: i % 5 === 0 }} cx={100 + Math.sin(angle) * 55} cy={125 - Math.cos(angle) * 55} r={i % 5 === 0 ? 2.8 : 1}/>; })}</g>
      <path class="clock-hand minute-hand" d="M100 125V83"/>
      <path class="clock-hand hour-hand" d="M100 125V97"/>
      <circle class="clock-center" cx="100" cy="125" r="4"/>
      <text class="note" x="100" y="217">Your schedule</text>
      <path class="route scheduled-route" d="M155 125H920V202Q920 232 890 232H350Q320 232 320 202V125"/>
      <path class="arrow" d="m313 202 7-9 7 9m308 34-9 6 9 6"/>
      {stages.map((stage, i) => <g class="scheduled-stage">
        <circle class="stage-flash" cx={320 + i * 200} cy="125" r="35"/>
        <text class="stage-label" x={320 + i * 200} y="57">{stage}</text>
        <circle class="node" cx={320 + i * 200} cy="125" r="34"/>
        <circle class="node-core" cx={320 + i * 200} cy="125" r="5"/>
      </g>)}
      <circle class="scheduled-traveler" cx="155" cy="125" r="6"/>
      <text class="note" x="620" y="201">Junjo preserves evidence for the next cycle</text>
    </svg>}
  </div>
</improvement-cycle-motion>

<script>
  class ImprovementCycleMotion extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      let visible = false, frame = 0, previous = 0, elapsed = 0;
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      const path = this.querySelector<SVGPathElement>('.scheduled-route');
      const dot = this.querySelector<SVGCircleElement>('.scheduled-traveler');
      const hourHand = this.querySelector<SVGElement>('.hour-hand');
      const minuteHand = this.querySelector<SVGElement>('.minute-hand');
      const stages = [...this.querySelectorAll<SVGElement>('.scheduled-stage')];
      const pathLength = path?.getTotalLength() ?? 0;
      const parallelRows = [...this.querySelectorAll<SVGGElement>('.parallel-row')].map(row => {
        const route = row.querySelector<SVGPathElement>('.parallel-route')!;
        const evidence = row.querySelector<SVGPathElement>('.evidence-route')!;
        return { row, route, evidence, length: route.getTotalLength(), evidenceLength: evidence.getTotalLength(), dot: row.querySelector<SVGCircleElement>('.loop-traveler')!, evidenceDot: row.querySelector<SVGCircleElement>('.evidence-traveler')!, stages: [...row.querySelectorAll<SVGElement>('.parallel-stage')], index: Number(row.dataset.row) };
      });
      const positionDot = (dot: SVGCircleElement, route: SVGPathElement, distance: number, active: boolean) => {
        const point = route.getPointAtLength(distance);
        dot.setAttribute('cx', String(point.x));
        dot.setAttribute('cy', String(point.y));
        dot.style.opacity = active && !motion.matches ? '1' : '0';
      };
      const flashStage = (stage: SVGElement, sinceArrival: number, active: boolean) => {
        const flash = active && sinceArrival >= 0 ? Math.max(0, 1 - sinceArrival / .5) : 0;
        stage.style.setProperty('--stage-flash', String(motion.matches ? 0 : flash));
      };
      const draw = () => {
        parallelRows.forEach(({ route, evidence, length, evidenceLength, dot, evidenceDot, stages, index }) => {
          const travelTime = (6 + index) / 2;
          const phase = (elapsed + index * 1.5) % (travelTime + .5);
          const active = phase < travelTime;
          const distance = Math.min(phase / travelTime, 1) * length;
          positionDot(dot, route, distance, active);
          stages.forEach(stage => flashStage(stage, (distance - Number(stage.dataset.distance)) / (length / travelTime), active));
          const finalArrival = Number(stages[3].dataset.distance) / length * travelTime;
          const evidenceProgress = (phase - finalArrival) / .6;
          positionDot(evidenceDot, evidence, Math.max(0, Math.min(1, evidenceProgress)) * evidenceLength, evidenceProgress >= 0 && evidenceProgress < 1);
        });
        if (!path || !dot || !hourHand || !minuteHand) return;
        const cycle = Math.floor(elapsed / 6.5), phase = elapsed % 6.5;
        // One minute-hand revolution advances the hour hand by one hour.
        const tick = Math.min(1, phase / 2);
        const eased = tick * tick * (3 - 2 * tick);
        const hours = cycle + eased;
        hourHand.style.transform = `rotate(${-60 + hours * 30}deg)`;
        minuteHand.style.transform = `rotate(${hours * 360}deg)`;
        const traveling = phase >= 2 && phase < 6;
        const distance = Math.max(0, Math.min(1, (phase - 2) / 4)) * pathLength;
        positionDot(dot, path, distance, traveling);
        stages.forEach((stage, index) => {
          // The four node centers lie on the first straight segment.
          flashStage(stage, (distance - (165 + index * 200)) / (pathLength / 4), traveling);
        });
      };
      const animate = (now: number) => {
        if (previous) elapsed += (now - previous) / 1000;
        previous = now;
        draw();
        frame = requestAnimationFrame(animate);
      };
      const update = () => {
        const running = visible && !document.hidden && !motion.matches;
        this.style.setProperty('--motion-state', running ? 'running' : 'paused');
        cancelAnimationFrame(frame);
        previous = 0;
        draw();
        if (running && (path || parallelRows.length)) frame = requestAnimationFrame(animate);
      };
      const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; update(); });
      observer.observe(this);
      document.addEventListener('visibilitychange', update);
      motion.addEventListener('change', update);
      update();
      this.cleanup = () => { cancelAnimationFrame(frame); observer.disconnect(); document.removeEventListener('visibilitychange', update); motion.removeEventListener('change', update); };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('improvement-cycle-motion')) customElements.define('improvement-cycle-motion', ImprovementCycleMotion);
</script>

<style>
  improvement-cycle-motion { display: block; margin: 32px 0; min-width: 0; }
  .visual-scroll { min-width: 0; }
  .visual-scroll:focus-visible { outline: 2px solid #9dc6ff; outline-offset: 4px; }
  svg { display: block; width: 100%; max-width: 100%; height: auto; }
  .parallel svg { max-width: 900px; margin-inline: auto; }
  .parallel-narrow { display: none; }
  .route { fill: none; stroke: #6e94ca; stroke-width: 1.5; stroke-dasharray: 1 7; stroke-linecap: round; }
  .dim-route { stroke: #42618b; }
  .arrow { fill: none; stroke: #91bfff; stroke-width: 1.5; }
  .node { fill: #0b1424; stroke: #89b7ef; stroke-width: 1.5; stroke-dasharray: 1 4; stroke-linecap: round; }
  .node-core { fill: #b9d7ff; filter: drop-shadow(0 0 5px #76aaff); }
  .stage-label { fill: #c5d9f5; font-size: 20px; text-anchor: middle; }
  .task-label { fill: #ffd09c; font-family: monospace; font-size: 16px; }
  .note { fill: #91a9cc; font-size: 14px; text-anchor: middle; }
  .clock-face { fill: #7b94b6; }
  .clock-face .hour { fill: #c8ddf8; }
  .clock-center { fill: #ffe1b5; }
  .clock-hand { fill: none; stroke-linecap: round; transform-origin: 100px 125px; }
  .minute-hand { stroke: #c3d9f5; stroke-width: 2; }
  .hour-hand { stroke: #ffd099; stroke-width: 4; transform: rotate(-60deg); }
  .stage-flash { fill: #ffd69b33; stroke: #fff0d5; stroke-width: 3; filter: drop-shadow(0 0 12px #ffd098); opacity: var(--stage-flash,0); }
  .scheduled-stage .node-core { fill: #d3e7ff; }
  .scheduled-traveler { fill: #ffe2ba; filter: drop-shadow(0 0 8px #ffd092); opacity: 0; }
  .loop-traveler { fill: #ffe2ba; filter: drop-shadow(0 0 7px #ffd092); opacity: 0; }
  .evidence-route { fill: none; stroke: none; }
  .evidence-traveler { fill: #badcff; filter: drop-shadow(0 0 5px #75b2ff); opacity: 0; }
  .studio-panel { fill: #122039; fill-opacity: .65; stroke: #48678e; stroke-width: 1; }
  .studio-dots { fill: #94caff; filter: drop-shadow(0 0 3px #679ff1); }
  .studio-label { fill: #d0e2ff; font-size: 24px; text-anchor: middle; }
  @media(max-width: 760px) {
    .parallel-wide { display: none; }
    .parallel-narrow { display: block; }
    .parallel-narrow .task-label { font-size: 21px; }
    .parallel-narrow .stage-label { font-size: 17px; }
    .parallel-narrow .studio-label { font-size: 20px; }
  }
</style>
