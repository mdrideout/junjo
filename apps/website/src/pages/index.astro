---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import HeroField from '../components/HeroField.astro';
---

<MarketingLayout
  title="Add Recursive Self Improvement To Your Application — Junjo"
  description="Create self-improving autonomous agent workflows with your existing agent framework and coding agent."
>
  <section class="hero" aria-labelledby="hero-title">
    <HeroField />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-content">
      <h1 id="hero-title">
        <span class="hero-add">add</span>{' '}
        <span class="hero-gradient">Recursive Self Improvement</span>{' '}
        <span class="hero-destination">To Your Application</span>
      </h1>
      <p class="hero-summary">Create self-improving autonomous agent workflows with your existing agent framework and coding agent.</p>
      <div class="hero-actions">
        <a class="button" href="/docs/#get-started">Get started <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/docs/">Explore the docs <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  <section class="hero-introduction" aria-label="About Junjo">
    <div class="hero-description">
      <p>Junjo is an agent-first eval-driven-development and ai-app telemetry platform, allowing coding agents to rapidly experiment with AI agent and workflow changes. Recursively make improvements based on grounded auditable evaluation data and detailed execution chronology.</p>
      <p>Junjo works with any coding agent and any agent framework. We supply agent-first observability for application execution and AI evaluators.</p>
    </div>
  </section>
</MarketingLayout>

<style>
  @font-face { font-family: Caveat; src: url('/fonts/caveat-regular.ttf') format('truetype'); font-weight: 400; font-display: swap; }
  .hero { position: relative; isolation: isolate; min-height: calc(100dvh - var(--hero-header-height, 90px)); overflow: hidden; background: #070a12; }
  .hero-shade { position: absolute; inset: 0; z-index: -1; pointer-events: none; background: linear-gradient(to top, rgba(7,10,18,1) 0%, rgba(7,10,18,.47) 30%, rgba(7,10,18,.14) 60%, rgba(7,10,18,0) 100%); }
  .hero-content { position: relative; min-height: inherit; padding: 24px 4vw 32px; display: flex; flex-direction: column; justify-content: flex-end; }
  h1 { margin: 0; font-size: clamp(44px,5.7vw,88px); line-height: 1.06; font-weight: 500; letter-spacing: -.065em; }
  h1, .hero-summary { flex-shrink: 0; }
  h1 > span { display: block; filter: drop-shadow(0 2px 3px #070a12cc) drop-shadow(0 0 12px #070a1299); }
  .hero-add { font-family: Caveat,cursive; font-size: clamp(32px,3vw,44px); font-weight: 400; line-height: .95; letter-spacing: 0; color: #ffb36b; background: linear-gradient(115deg,#ffda9e,#ffb36b 48%,#ff8c55); background-clip: text; -webkit-text-fill-color: transparent; width: fit-content; padding-right: .15em; margin-bottom: -2px; }
  .hero-gradient { width: fit-content; color: #6688ff; background: linear-gradient(105deg,#3558ff 0%,#679dff 20%,#9ccaff 35%,#7984ff 50%,#4668ff 67%,#6eb7ff 83%,#3558ff 100%); background-size: 240% 100%; background-clip: text; -webkit-text-fill-color: transparent; animation: hero-color-flow 12s ease-in-out infinite alternate; }
  .hero-destination { font-size: clamp(28px,3.3vw,48px); font-weight: 900; line-height: 1.2; letter-spacing: -.045em; color: #edf2ff; margin-top: -3px; text-shadow: 0 3px 4px #000,0 0 18px #000b; }
  .hero-summary { max-width: 500px; margin: 20px 0 0; font-size: clamp(16px,1.45vw,20px); line-height: 1.6; color: #c3cddd; text-wrap: pretty; text-shadow: 0 2px 8px #070a12,0 0 20px #070a1299; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 30px; flex-shrink: 0; margin: clamp(24px,6dvh,64px) 0 0; }
  .hero-actions a { white-space: nowrap; }
  .hero-actions .button { gap: 4px; padding: 16px 22px; min-height: 52px; font-weight: 400; }
  .hero-actions .text-link { gap: 4px; }
  .hero-introduction { padding: 90px 7vw 105px; background: #090e1b; border-top: 1px solid #36589e26; }
  .hero-description { max-width: 920px; margin: auto; font-size: clamp(18px,1.65vw,24px); color: #c1cadc; }
  .hero-description p { margin: 0; line-height: 1.75; }
  .hero-description p + p { margin-top: 30px; color: #9eacc6; }
  @keyframes hero-color-flow { from { background-position: 0% 50%; } to { background-position: 100% 50%; } }
  @media (max-height: 800px) and (min-width: 761px) {
    h1 { font-size: clamp(44px,5.7vw,72px); }
    .hero-destination { font-size: 34px; }
    .hero-content { padding-bottom: 24px; }
  }
  @media (max-width: 760px) {
    .hero { --hero-header-height: 80px; }
    .hero-content { padding: 24px 24px 30px; }
    h1 { font-size: clamp(42px,8.5vw,62px); max-width: 620px; }
    .hero-actions { gap: 18px 24px; }
    .hero-introduction { padding: 58px 24px 70px; }
    .hero-description { font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-gradient { animation: none; } }
</style>
