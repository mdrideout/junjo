# -----------------------------------------------------------------------------
# Junjo AI Studio application telemetry
# -----------------------------------------------------------------------------

# Local OTLP/gRPC endpoint and transport setting. The endpoint includes its port;
# `insecure=true` disables TLS for repository-local development.
JUNJO_AI_STUDIO_OTLP_ENDPOINT=localhost:26155
JUNJO_AI_STUDIO_OTLP_INSECURE=true

# Create an Application Telemetry API Key in Junjo AI Studio.
# JUNJO_AI_STUDIO_API_KEY=jtel_...

# -----------------------------------------------------------------------------
# Gemini model provider
# -----------------------------------------------------------------------------

# Create a key at https://aistudio.google.com/app/api-keys.
# GEMINI_API_KEY=
