# -----------------------------------------------------------------------------
# AI Chat local development
# -----------------------------------------------------------------------------

# Browser and API ports published by Docker Compose.
AI_CHAT_FRONTEND_PORT=26251
AI_CHAT_BACKEND_PORT=26252

# -----------------------------------------------------------------------------
# Live model provider
# -----------------------------------------------------------------------------

# Select one live provider. Add the corresponding secret below before starting
# AI Chat; the example intentionally has no demo or fallback provider.
AI_CHAT_MODEL_PROVIDER=gemini
# GEMINI_API_KEY=
# XAI_API_KEY=

# Explicit example defaults make provider selection and model changes visible.
AI_CHAT_GEMINI_TEXT_MODEL=gemini-3.5-flash
AI_CHAT_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
AI_CHAT_GROK_TEXT_MODEL=grok-4.3
AI_CHAT_GROK_IMAGE_MODEL=grok-imagine-image-quality
AI_CHAT_PROVIDER_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Application telemetry: AI Chat -> Studio OTLP/gRPC ingestion
# -----------------------------------------------------------------------------

# Create this credential from Studio > API Keys. It authorizes application
# telemetry only and is intentionally different from the developer token below.
# JUNJO_AI_STUDIO_API_KEY=jtel_...

# Host-native application and evaluation runs use this endpoint. For the
# repository-local Docker topology, compose.yaml gives AI Chat the equivalent
# host.docker.internal:26155 endpoint.
JUNJO_AI_STUDIO_OTLP_ENDPOINT=localhost:26155
JUNJO_AI_STUDIO_OTLP_INSECURE=true

# -----------------------------------------------------------------------------
# Developer control/query: Junjo SDK and CLI -> Studio backend REST API
# -----------------------------------------------------------------------------

# Create this credential from Studio > Access Tokens. It authorizes SDK and CLI
# access to datasets, evaluation runs, and evidence; it cannot ingest telemetry.
JUNJO_AI_STUDIO_BACKEND_BASE_URL=http://localhost:26154
# JUNJO_AI_STUDIO_CLI_TOKEN=jcli_...

# -----------------------------------------------------------------------------
# Browser diagnostics: AI Chat -> Studio frontend
# -----------------------------------------------------------------------------

# AI Chat uses this browser-facing origin to build authenticated links to the
# exact Workflow, Agent, and trace evidence behind a completed Turn. The URL is
# exposed to the browser only when application telemetry is configured.
JUNJO_AI_STUDIO_FRONTEND_BASE_URL=http://localhost:26151
