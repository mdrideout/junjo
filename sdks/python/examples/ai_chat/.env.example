# Stable host and container ports shared by Compose and native development.
AI_CHAT_FRONTEND_PORT=26251
AI_CHAT_BACKEND_PORT=26252

# Explicit live provider selection. Missing credentials fail startup; there is
# no demo behavior or fallback provider in the product application.
AI_CHAT_MODEL_PROVIDER=gemini
# GEMINI_API_KEY=
# XAI_API_KEY=
# AI_CHAT_GEMINI_TEXT_MODEL=gemini-3.5-flash
# AI_CHAT_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# AI_CHAT_GROK_TEXT_MODEL=grok-4.3
# AI_CHAT_GROK_IMAGE_MODEL=grok-imagine-image-quality
# AI_CHAT_PROVIDER_TIMEOUT_SECONDS=120

# One Junjo AI Studio deployment serves both application telemetry and the
# evaluation CLI. The credentials remain intentionally separate because they
# authorize different systems.
#
# Application telemetry -> Studio OTLP ingestion. Create this API key from the
# Studio API Keys page. It cannot query or mutate evaluation datasets.
# JUNJO_AI_STUDIO_API_KEY=jtel_...
# JUNJO_AI_STUDIO_PORT=26155
# JUNJO_AI_STUDIO_INSECURE=true

# Developer environment or agent -> Studio backend REST API. After signing in
# to Studio at http://localhost:26153, open Access Tokens, create a scoped
# developer access token, and copy it here. It cannot ingest
# application telemetry.
JUNJO_STUDIO_URL=http://localhost:26154
# JUNJO_AI_STUDIO_CLI_TOKEN=jcli_...

# Debug mode exposes Studio resolver links; it never exposes the API key.
# AI_CHAT_DEBUG=true
# AI_CHAT_STUDIO_UI_URL=http://localhost:26153
