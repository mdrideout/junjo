# Application telemetry: the ingestion-only key created under API Keys in Studio.
JUNJO_AI_STUDIO_API_KEY=
JUNJO_AI_STUDIO_OTLP_ENDPOINT=localhost:26155
JUNJO_AI_STUDIO_OTLP_INSECURE=true

# Evaluation control and queries: the developer token created under Access Tokens.
JUNJO_AI_STUDIO_BACKEND_BASE_URL=http://localhost:26154
JUNJO_AI_STUDIO_CLI_TOKEN=

# Local examples intentionally retain prompt and response content in spans.
# Review the privacy implications before enabling content capture in production.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_ONLY
