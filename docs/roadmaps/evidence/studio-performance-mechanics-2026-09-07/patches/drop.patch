+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::time::Instant;
+use std::io::{self, Write};
+use std::fs::File;
+const NAMES: [&str; 15] = ["convert", "auth_wait", "wal_wait", "wal_write", "notify_wait", "cold_lock_wait", "cold_flush", "snapshot_cache_wait", "snapshot_wal_wait", "snapshot_build", "arrow_build", "ipc_write", "ipc_read", "flush_check", "rpc_total"];
+struct Metric { count: AtomicU64, wall: AtomicU64, cpu: AtomicU64, max: AtomicU64 }
+impl Metric { const fn new() -> Self { Self { count:AtomicU64::new(0),wall:AtomicU64::new(0),cpu:AtomicU64::new(0),max:AtomicU64::new(0) } } }
+static METRICS: [Metric; 15] = [const { Metric::new() }; 15];
+static WRITES:AtomicU64=AtomicU64::new(0);
+static BYTES:AtomicU64=AtomicU64::new(0);
+pub static FULL:AtomicU64=AtomicU64::new(0);
+#[repr(C)] struct Timespec { sec:i64,nsec:i64 }
+unsafe extern "C" { fn clock_gettime(clock:i32, out:*mut Timespec)->i32; }
+fn cpu_ns()->u64 { let mut t=Timespec{sec:0,nsec:0}; assert_eq!(unsafe{clock_gettime(3,&mut t)},0); t.sec as u64*1_000_000_000+t.nsec as u64 }
+pub struct Timer { i:usize, wall:Instant, cpu:Option<u64> }
+impl Timer { pub fn sync(i:usize)->Self {Self{i,wall:Instant::now(),cpu:Some(cpu_ns())}} pub fn wall(i:usize)->Self {Self{i,wall:Instant::now(),cpu:None}} }
+impl Drop for Timer { fn drop(&mut self) {let wall=self.wall.elapsed().as_nanos() as u64;let m=&METRICS[self.i];m.count.fetch_add(1,Relaxed);m.wall.fetch_add(wall,Relaxed);m.max.fetch_max(wall,Relaxed);if let Some(c)=self.cpu {m.cpu.fetch_add(cpu_ns()-c,Relaxed);} } }
+pub struct CountedFile(pub File);
+impl Write for CountedFile {fn write(&mut self,b:&[u8])->io::Result<usize>{let n=self.0.write(b)?;WRITES.fetch_add(1,Relaxed);BYTES.fetch_add(n as u64,Relaxed);Ok(n)} fn flush(&mut self)->io::Result<()> {self.0.flush()} }
+pub fn dump() {let metrics:Vec<_>=METRICS.iter().enumerate().map(|(i,m)|serde_json::json!({"phase":NAMES[i],"count":m.count.load(Relaxed),"wall_ns":m.wall.load(Relaxed),"thread_cpu_ns":m.cpu.load(Relaxed),"max_wall_ns":m.max.load(Relaxed)})).collect();eprintln!("JUNJO_PROFILE {}",serde_json::json!({"metrics":metrics,"ipc_write_calls":WRITES.load(Relaxed),"ipc_write_bytes":BYTES.load(Relaxed),"full_notification_queue":FULL.load(Relaxed),"available_parallelism":std::thread::available_parallelism().unwrap().get()}));}
