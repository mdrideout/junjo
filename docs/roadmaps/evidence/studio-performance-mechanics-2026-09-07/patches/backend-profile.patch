+import atexit, cProfile, functools, io, json, os, pstats, sys, threading, time
+from collections import defaultdict
+stats=defaultdict(lambda: {"count":0,"wall_ns":0,"thread_cpu_ns":0,"max_wall_ns":0})
+lock=threading.Lock()
+profiles={}
+def record(name,wall,cpu):
+    with lock:
+        s=stats[name];s["count"]+=1;s["wall_ns"]+=wall;s["thread_cpu_ns"]+=cpu;s["max_wall_ns"]=max(s["max_wall_ns"],wall)
+def measured(name,profile=False):
+    def decorate(f):
+        @functools.wraps(f)
+        def wrap(*a,**k):
+            first=False
+            if profile and os.environ.get("JUNJO_DIAGNOSTIC_CPROFILE")=="1":
+                with lock:
+                    if name not in profiles: profiles[name]=None;first=True
+            started=time.perf_counter_ns();cpu=time.thread_time_ns()
+            try:
+                if first:
+                    p=cProfile.Profile()
+                    try:return p.runcall(f,*a,**k)
+                    finally:
+                        stream=io.StringIO();pstats.Stats(p,stream=stream).sort_stats("tottime").print_stats(35)
+                        with lock: profiles[name]=stream.getvalue()
+                return f(*a,**k)
+            finally:record(name,time.perf_counter_ns()-started,time.thread_time_ns()-cpu)
+        return wrap
+    return decorate
+def measured_async(name):
+    def decorate(f):
+        @functools.wraps(f)
+        async def wrap(*a,**k):
+            started=time.perf_counter_ns()
+            try:return await f(*a,**k)
+            finally:record(name,time.perf_counter_ns()-started,0)
+        return wrap
+    return decorate
+@atexit.register
+def dump():
+    print("JUNJO_BACKEND_PROFILE "+json.dumps(dict(stats)),file=sys.stderr)
+    for name,summary in profiles.items(): print("JUNJO_CPROFILE "+name+"\n"+str(summary),file=sys.stderr)
