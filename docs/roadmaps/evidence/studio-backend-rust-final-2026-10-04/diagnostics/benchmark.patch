+def workload_query_paths(kind: str, config: "BenchmarkConfig") -> list[str]:
+    """What the workload's query workers ask for while spans arrive."""
+    if kind == "services":
+        return ["/api/v1/observability/services"]
+    if kind == "trace":
+        # The first export of each exporter: one trace of spans_per_export
+        # spans, sent in the first moments of the workload.
+        from delivery import workload_trace_id
 
+        return [
+            f"/api/v1/observability/traces/{workload_trace_id(exporter_id, 0).hex()}/spans"
+            for exporter_id in range(config.exporters)
+        ]
+    if kind == "list":
+        return [
+            f"/api/v1/observability/services/metadata-benchmark-{index}/spans/root"
+            for index in range(3)
+        ]
+    raise ValueError(f"unknown workload query kind {kind}")
 
