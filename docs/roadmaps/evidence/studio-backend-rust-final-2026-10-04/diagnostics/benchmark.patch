+def memory_breakdown(environment: dict[str, str], use_auth_proxy: bool) -> dict:
+    """Read cgroup and per-process memory for both services, inside each container."""
+    breakdown = {}
+    for service in ("backend", "ingestion"):
+        container_id = run(
+            compose_command(use_auth_proxy, "ps", "--quiet", service),
+            env=environment,
+        ).stdout.strip()
+        output = run(
+            ["docker", "exec", container_id, "sh", "-c", MEMORY_BREAKDOWN_COMMAND],
+            env=environment,
+        ).stdout
+        item: dict[str, Any] = {"stat": {}, "events": {}, "processes": []}
+        for line in output.splitlines():
+            parts = line.split()
+            if not parts:
+                continue
+            if parts[0] == "memory.current":
+                item["memory_current_bytes"] = int(parts[1])
+            elif parts[0] == "memory.peak":
+                item["memory_peak_bytes"] = int(parts[1])
+            elif parts[0].startswith("events."):
+                item["events"][parts[0][7:]] = int(parts[1])
+            elif parts[0] == "process":
+                rss_kib = int(parts[3])
+                if rss_kib and parts[2] not in {"sh", "cat", "awk", "grep", "sed"}:
+                    item["processes"].append(
+                        {
+                            "pid": int(parts[1]),
+                            "comm": parts[2],
+                            "rss_kib": rss_kib,
+                            "rss_anon_kib": int(parts[4]),
+                            "threads": int(parts[5]),
+                        }
+                    )
+            elif len(parts) == 2:
+                item["stat"][parts[0]] = int(parts[1])
+        item["working_set_bytes"] = item["memory_current_bytes"] - item["stat"].get(
+            "inactive_file", 0
+        )
+        item["process_rss_kib"] = sum(p["rss_kib"] for p in item["processes"])
+        breakdown[service] = item
+    return breakdown
+
