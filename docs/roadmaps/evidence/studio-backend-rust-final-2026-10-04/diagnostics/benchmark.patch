+async def filtered_query_phase(
+    client: httpx.AsyncClient,
+    config: BenchmarkConfig,
+    diagnostics: Diagnostics,
+    environment: dict[str, str],
+) -> dict[str, Any]:
+    """Evidence-run phase: filtered queries over the indexed data.
+
+    Runs after ingestion and indexing have completed and the workload's query
+    workers have stopped, so only these queries use the backend. Two workers,
+    like the workload's query workers.
+
+    - Trace queries filter on one trace ID. With delivery verification on,
+      each export is one trace of `spans_per_export` spans, so a trace sits
+      in one cold file and the filter matches a small share of its rows.
+    - Listing queries filter on one of the three service names and keep the
+      most recent root spans, so the filter matches a third of the rows.
+    """
+
+    async def run_set(paths: list[str]) -> dict[str, Any]:
+        latencies: list[float] = []
+        codes: Counter[str] = Counter()
+        rows: Counter[str] = Counter()
+        pending = iter(paths)
+
+        async def worker() -> None:
+            for path in pending:
+                started = time.perf_counter()
+                try:
+                    response = await client.get(path, timeout=300)
+                    codes[str(response.status_code)] += 1
+                    if response.status_code == 200:
+                        rows[str(len(response.json()))] += 1
+                except httpx.HTTPError:
+                    codes["transport_error"] += 1
+                latencies.append((time.perf_counter() - started) * 1000)
+
+        before = container_metrics(environment, config.use_auth_proxy)
+        started = time.perf_counter()
+        await asyncio.gather(worker(), worker())
+        seconds = time.perf_counter() - started
+        after = container_metrics(environment, config.use_auth_proxy)
+        return {
+            "queries": len(paths),
+            "seconds": seconds,
+            "result_codes": dict(codes),
+            "rows_returned": dict(rows),
+            **latency_summary(latencies),
+            "backend_cpu_seconds": after["backend"]["cpu_usage_seconds"]
+            - before["backend"]["cpu_usage_seconds"],
+            "ingestion_cpu_seconds": after["ingestion"]["cpu_usage_seconds"]
+            - before["ingestion"]["cpu_usage_seconds"],
+            "backend_peak_cgroup_memory_bytes_before": before["backend"][
+                "peak_cgroup_memory_bytes"
+            ],
+            "backend_peak_cgroup_memory_bytes_after": after["backend"][
+                "peak_cgroup_memory_bytes"
+            ],
+        }
 
+    # Distinct traces the exporters wrote, spread over every exporter and over
+    # the whole run, so they fall in every cold file. Requires the delivery
+    # verification workload, whose trace identities are known.
+    from delivery import workload_trace_id
 
+    trace_paths = []
+    for index in range(diagnostics.trace_queries):
+        exporter_id = index % config.exporters
+        export_index = (index * 37) % config.exports_per_exporter
+        trace_id = workload_trace_id(exporter_id, export_index).hex()
+        trace_paths.append(f"/api/v1/observability/traces/{trace_id}/spans")
+    if len(set(trace_paths)) != len(trace_paths):
+        raise ValueError("trace query identities are not distinct")
+    list_paths = [
+        f"/api/v1/observability/services/metadata-benchmark-{index % 3}/spans/root"
+        for index in range(diagnostics.list_queries)
+    ]
+    result: dict[str, Any] = {"status": "measured"}
+    if trace_paths:
+        result["trace"] = await run_set(trace_paths)
+    if list_paths:
+        result["list"] = await run_set(list_paths)
+    result["memory"] = memory_breakdown(environment, config.use_auth_proxy)
+    return result
+
