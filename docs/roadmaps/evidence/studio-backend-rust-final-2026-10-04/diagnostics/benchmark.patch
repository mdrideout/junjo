+MEMORY_BREAKDOWN_COMMAND = (
+    'echo "memory.current $(cat /sys/fs/cgroup/memory.current)"; '
+    'echo "memory.peak $(cat /sys/fs/cgroup/memory.peak)"; '
+    "grep -E '^(anon|file|kernel|shmem|file_mapped|inactive_file|active_file|"
+    "inactive_anon|active_anon|slab|sock|pagetables|kernel_stack) ' "
+    "/sys/fs/cgroup/memory.stat; "
+    "sed 's/^/events./' /sys/fs/cgroup/memory.events; "
+    "self=$$; for pid in $(cat /sys/fs/cgroup/cgroup.procs); do "
+    '[ "$pid" = "$self" ] && continue; '
+    "comm=$(cat /proc/$pid/comm 2>/dev/null || true); "
+    "rss=$(awk '/^VmRSS:/ {print $2}' /proc/$pid/status 2>/dev/null); "
+    "anon=$(awk '/^RssAnon:/ {print $2}' /proc/$pid/status 2>/dev/null); "
+    "threads=$(awk '/^Threads:/ {print $2}' /proc/$pid/status 2>/dev/null); "
+    'echo "process $pid ${comm:-gone} ${rss:-0} ${anon:-0} ${threads:-0}"; done'
+)
