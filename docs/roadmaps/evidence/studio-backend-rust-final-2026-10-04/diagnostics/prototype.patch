+/// Select a query's files and run it.
+///
+/// PROTOTYPE (`hot_retry`): ingestion rewrites the hot snapshot in place and
+/// removes it when its log is empty. A query that fails after ingestion has
+/// done either was reading a file that changed under it, so ingestion is
+/// asked again and the query runs once more over what it names now. A query
+/// that ran out of memory is not run again.
+async fn run_query(
+    state: &AppState,
+    selection: Selection<'_>,
+    query: SpanQuery<'_>,
+) -> Result<datafusion::error::Result<(Vec<Span>, QuerySources)>, ApiError> {
+    let mut sources = select_sources(state, selection).await?;
+    let mut handed = snapshot_identity(&sources);
+    // PROTOTYPE (`hot_retry`): ingestion named a snapshot that is already
+    // gone, so its log was flushed since. Asking again names the cold file
+    // those spans went to.
+    if state.query.hot_retry && sources.hot_snapshot.is_some() && handed.is_none() {
+        sources = select_sources(state, selection).await?;
+        handed = snapshot_identity(&sources);
+    }
+    match state.query.run(&sources, query).await {
+        Ok(spans) => Ok(Ok((spans, sources))),
+        Err(error)
+            if state.query.hot_retry
+                && sources.hot_snapshot.is_some()
+                && !matches!(error.find_root(), DataFusionError::ResourcesExhausted(_))
+                && snapshot_identity(&sources) != handed =>
+        {
+            tracing::warn!(
+                %error,
+                "the hot snapshot changed while it was read; asking ingestion again"
+            );
+            let sources = select_sources(state, selection).await?;
+            Ok(state
+                .query
+                .run(&sources, query)
+                .await
+                .map(|spans| (spans, sources)))
+        }
+        Err(error) => Ok(Err(error)),
+    }
+}
