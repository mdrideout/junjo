+                    else {
+                        continue;
+                    };
+                    if !llm_trace_ids.contains(trace_id) && classify_attributes(attributes).is_llm {
+                        llm_trace_ids.insert(trace_id.to_string());
+                    }
+                }
+            }
+        }
+        Ok(llm_trace_ids)
+    }
